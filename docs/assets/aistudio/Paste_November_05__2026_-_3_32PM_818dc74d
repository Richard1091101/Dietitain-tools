    document.addEventListener('change', (e) => {
      const ds = e.target.dataset;
      if (!ds || !ds.action) return;
      const val = e.target.value;

      // 📥 CSV 匯入核心引擎
      if (ds.action === 'handleCSV' && e.target.id === 'csvFileInput') {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(evt) {
          try {
            const text = evt.target.result;
            const lines = text.split('\n');
            let importCount = 0;
            for (let i = 2; i < lines.length; i++) {
              const line = lines[i].trim();
              if (!line) continue;
              const cols = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(s => s.replace(/^"|"$/g, '').trim());
              if (cols.length < 4) continue;
              
              const cat = cols[0]; 
              if (FOOD_DB[cat]) {
                const newItem = {
                  name: cols[1], unit: cols[2], uW: parseFloat(cols[3]) || 100,
                  c: parseFloat(cols[4]) || 0, p: parseFloat(cols[5]) || 0, f: parseFloat(cols[6]) || 0,
                  fiber: parseFloat(cols[7]) || 0, na: parseFloat(cols[8]) || 0, k: parseFloat(cols[9]) || 0,
                  phos: parseFloat(cols[10]) || 0, ca: parseFloat(cols[11]) || 0, mag: parseFloat(cols[12]) || 0,
                  epa: parseFloat(cols[13]) || 0, n3: parseFloat(cols[14]) || 0, b12: parseFloat(cols[15]) || 0,
                  vitA: parseFloat(cols[16]) || 0, folic: parseFloat(cols[17]) || 0, vitD: parseFloat(cols[18]) || 0,
                  fe: parseFloat(cols[19]) || 0, zn: parseFloat(cols[20]) || 0, se: parseFloat(cols[21]) || 0
                };
                FOOD_DB[cat].push(newItem);
                importCount++;
              }
            }
            alert(`✅ 成功匯入 ${importCount} 筆自訂食材！\n這些食材已加入下拉選單與隨機題庫中。`);
            renderApp();
          } catch(err) {
            alert('❌ 匯入失敗，請確認 CSV 檔案格式是否正確。');
          }
          e.target.value = ''; 
        };
        reader.readAsText(file, 'UTF-8');
      }
      else if (ds.action === 'macroInput') {
        const v = parseFloat(val) >= 0 ? parseFloat(val) : 0;
        let { calories, protein, carbs, fat } = state.targets;
        if (ds.field === 'calories') { calories = v; fat = (calories-protein*4-carbs*4)/9; if(fat<0){fat=0; carbs=(calories-protein*4)/4; if(carbs<0){carbs=0;protein=calories/4;}} }
        else if (ds.field === 'protein') { protein = v; fat = (calories-protein*4-carbs*4)/9; if(fat<0){fat=0; carbs=(calories-protein*4)/4; if(carbs<0){carbs=0;calories=protein*4;}} }
        else if (ds.field === 'carbs') { carbs = v; fat = (calories-protein*4-carbs*4)/9; if(fat<0){fat=0;calories=protein*4+carbs*4;} }
        else if (ds.field === 'fat') { fat = v; carbs = (calories-protein*4-fat*9)/4; if(carbs<0){carbs=0;calories=protein*4+fat*9;} }
        state.targets = { calories: Math.round(calories), protein: Math.round(protein*10)/10, carbs: Math.round(carbs*10)/10, fat: Math.round(fat*10)/10 };
        renderApp();
      } 
      else if (ds.action === 'tdeeInput') {
        state.tdeeParams[ds.field] = ds.type === 'num' ? Number(val) : val;
        renderApp();
      }
      else if (ds.action === 'itemChange') {
        updateMenuData(ds.day, ds.meal, meal => {
          meal[ds.cat] = { ...meal[ds.cat] };
          const dbMap = { carb: 'carbs', protein: 'proteins', side: 'sides', veggie: 'veggies' };
          meal[ds.cat].item = FOOD_DB[dbMap[ds.cat]].find(i => i.name === val);
          
          const { c: tC, p: tP, f: tF, mainP: tMainP } = meal.targets;
          const pI = meal.protein?.item; const cI = meal.carb?.item; const sI = meal.side?.item; const vI = meal.veggie?.item;
          let vW = meal.veggie ? 100 : 0; let pW = (pI && pI.p > 0) ? Math.max(0, tMainP/pI.p) : 0;
          let C_rem = tC - (vI ? vI.c*vW : 0); let P_rem = tP - (vI ? vI.p*vW : 0) - (pI ? pI.p*pW : 0);
          let sW = 0; let cW = 0;
          
          if (sI && cI) {
            const ratio = (cI.c > 0) ? (cI.p/cI.c) : 0; const denom = sI.p - (sI.c*ratio);
            if (denom > 0.001) { sW = (P_rem - C_rem*ratio)/denom; if (sW < 0) sW = 0; } else { sW = Math.max(0, P_rem/(sI.p||1)); }
            cW = (C_rem - sW*sI.c)/(cI.c||1); if (cW < 0) { cW = 0; sW = Math.max(0, P_rem/(sI.p||1)); }
          } else if (sI && !cI) { sW = Math.max(0, P_rem/(sI.p||1)); } else if (!sI && cI) { cW = Math.max(0, C_rem/(cI.c||1)); }

          if(meal.protein) meal.protein.weight = Math.round(pW); if(meal.side) meal.side.weight = Math.round(sW);
          if(meal.carb) meal.carb.weight = Math.round(cW); if(meal.veggie) meal.veggie.weight = Math.round(vW);

          const curFat = (vI?vI.f*vW:0) + (cI?cI.f*cW:0) + (pI?pI.f*pW:0) + (sI?sI.f*sW:0);
          const oI = FOOD_DB.oils.find(o => o.name === meal.oilName); let oW = Math.max(0, (tF - curFat)/oI.f);
          let remOil = Math.round(oW); const acts = [];
          if(meal.carb) acts.push('carb'); if(meal.protein) acts.push('protein'); if(meal.side) acts.push('side'); if(meal.veggie) acts.push('veggie');
          if(acts.length>0) {
            acts.forEach(c => meal[c].oil=0); while(remOil>0) { meal[acts[Math.floor(Math.random()*acts.length)]].oil++; remOil--; }
            acts.forEach(c => { meal[c].method = getRandom(getCookingMethod(meal[c].oil, c==='side'?'sides':c==='veggie'?'veggies':c==='carb'?'carbs':'proteins', meal[c].item.name)); });
          }
        });
      }
      else if (ds.action === 'snackChange' || ds.action === 'extraChange') {
        updateMenuData(ds.day, ds.meal, meal => {
          let found = null; let fType = '';
          for(const grp of ALL_OPTIONS) { const m = grp.options.find(i=>i.name===val); if(m){found=m; fType=grp.type; break;} }
          if(!found) return;
          const arr = meal.isMain ? meal.extra : meal.items;
          
          const newItem = { ...found, weight: found.uW||100, type: fType };
          if (meal.isMain && ['carbs', 'proteins', 'sides', 'veggies'].includes(fType)) {
             newItem.oil = 0;
             const mapCat = fType === 'carbs' ? 'carbs' : fType === 'proteins' ? 'proteins' : fType === 'sides' ? 'sides' : 'veggies';
             newItem.method = getRandom(getCookingMethod(0, mapCat, newItem.name));
          }
          arr[ds.idx] = newItem;
        });
      }
      else if (ds.action === 'weightChange') { updateMenuData(ds.day, ds.meal, meal => { meal[ds.cat].weight = val===''?0:Number(val); }); }
      else if (ds.action === 'snackWeightChange') { updateMenuData(ds.day, ds.meal, meal => { const arr = meal.isMain ? meal.extra : meal.items; arr[ds.idx].weight = val===''?0:Number(val); }); }
      else if (ds.action === 'oilChange') {
        updateMenuData(ds.day, ds.meal, meal => {
          meal[ds.cat].oil = val===''?0:Number(val);
          const mapCat = ds.cat==='carb'?'carbs':ds.cat==='protein'?'proteins':ds.cat==='side'?'sides':'veggies';
          meal[ds.cat].method = getRandom(getCookingMethod(Number(val)||0, mapCat, meal[ds.cat].item.name));
        });
      }
      // 加點的獨立油量計算
      else if (ds.action === 'extraOilChange') {
        updateMenuData(ds.day, ds.meal, meal => {
          const item = meal.extra[ds.idx];
          item.oil = val === '' ? 0 : Number(val);
          const mapCat = item.type === 'carbs' ? 'carbs' : item.type === 'proteins' ? 'proteins' : item.type === 'sides' ? 'sides' : 'veggies';
          item.method = getRandom(getCookingMethod(Number(val)||0, mapCat, item.name));
