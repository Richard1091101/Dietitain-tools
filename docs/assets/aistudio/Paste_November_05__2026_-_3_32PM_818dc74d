      else if (ds.action === 'downloadTemplate') {
        const template = "\uFEFF類別碼,食材名稱,單位,單位重量(g),碳水(c),蛋白質(p),脂肪(f),纖維(fiber),鈉(na),鉀(k),磷(phos),鈣(ca),鎂(mag),EPA(epa),Omega3(n3),維生素B12(b12),維生素A(vitA),葉酸(folic),維生素D(vitD),鐵(fe),鋅(zn),硒(se)\n" +
