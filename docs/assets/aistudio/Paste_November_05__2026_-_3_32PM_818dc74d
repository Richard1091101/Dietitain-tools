      .main-content { gap: 10px; }
      .meal-card { break-inside: avoid; border: 1px solid #ccc; background: white !important; }
      .stats-panel { border: 1px solid #ccc; }
      select { appearance: none; -webkit-appearance: none; border: none !important; background: transparent !important; }
      input { border: none !important; background: transparent !important; }
      .add-select { display: none; }
      .tag-method-select { border: none !important; pointer-events: none; } 
    }
  </style>
</head>
