          if(meal.isMain) { if(!meal.extra) meal.extra=[]; meal.extra.push(newItem); } else { if(!meal.items) meal.items=[]; meal.items.push(newItem); }
        });
      }
    });

    document.addEventListener('input', (e) => {
      const ds = e.target.dataset;
      if(ds.action === 'macroSlider') {
        const field = ds.field; const newPct = parseInt(e.target.value);
        let cals = state.targets.calories; if(!cals) return;
        let p = Math.round((state.targets.protein*4/cals)*100)||0; let c = Math.round((state.targets.carbs*4/cals)*100)||0; let f = 100-p-c; if(f<0) f=0;
        let diff = newPct - (field==='p'?p:field==='c'?c:f);
        if(field==='p'){ p=newPct; if(c-diff>=0)c-=diff; else{let rem=diff-c; c=0; f-=rem;} }
        else if(field==='c'){ c=newPct; if(f-diff>=0)f-=diff; else{let rem=diff-f; f=0; p-=rem;} }
        else if(field==='f'){ f=newPct; if(c-diff>=0)c-=diff; else{let rem=diff-c; c=0; p-=rem;} }
        p=Math.max(0,Math.min(100,p)); c=Math.max(0,Math.min(100,c)); f=Math.max(0,Math.min(100,f));
        state.targets = { calories: cals, protein: Math.round((cals*(p/100))/4*10)/10, carbs: Math.round((cals*(c/100))/4*10)/10, fat: Math.round((cals*(f/100))/9*10)/10 };
