                         "carbs,特製胚芽紫米飯(範例),碗,160,0.25,0.04,0.01,0.02,0.02,1.5,1.0,0.1,0.5,0,0,0,0,0.1,0,0.01,0.01,0.01";
        const blob = new Blob([template], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a'); 
        link.href = url; link.download = '食材匯入範本_DietGenerator.csv'; link.click(); URL.revokeObjectURL(url);
      }
      
      else if (ds.action === 'exportHTML') {
        const originalElement = document.querySelector('.main-content');
        if(!originalElement) return;
        const clone = originalElement.cloneNode(true);

        const originalSelects = originalElement.querySelectorAll('select');
        clone.querySelectorAll('select').forEach((clonedSelect, index) => {
          const originalVal = originalSelects[index].value;
          Array.from(clonedSelect.options).forEach(opt => {
            if (opt.value === originalVal) opt.setAttribute('selected', 'selected');
            else opt.removeAttribute('selected');
          });
        });

        const originalInputs = originalElement.querySelectorAll('input');
        clone.querySelectorAll('input').forEach((clonedInput, index) => {
          clonedInput.setAttribute('value', originalInputs[index].value);
        });

        clone.querySelectorAll('.print-hidden').forEach(el => el.remove());

        const htmlContent = `<!DOCTYPE html>
