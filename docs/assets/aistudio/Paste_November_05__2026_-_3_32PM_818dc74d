</html>`;

        const url = URL.createObjectURL(new Blob([htmlContent], { type: 'text/html;charset=utf-8' }));
        const link = document.createElement('a'); 
        link.href = url; link.download = `專屬營養菜單_${state.numDays}天.html`; link.click(); URL.revokeObjectURL(url);
      }
      else if (ds.action === 'print') {
