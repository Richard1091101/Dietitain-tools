        case 'proteins': return '🐟';
        case 'sides': return '🍳';
        case 'veggies': return '🥬';
        case 'dairy': return '🥛';
        case 'fruits': return '🍎';
        default: return '🍽️';
      }
    };
    
    const getLabelForType = (type) => {
      switch(type) {
        case 'carbs': case 'snackCarbs': return '主食';
        case 'proteins': return '蛋白質';
        case 'sides': return '副菜';
        case 'veggies': return '蔬菜';
        case 'dairy': return '乳品';
        case 'fruits': return '水果';
        default: return '加點';
      }
    };

    const getCookingMethod = (oilGrams, type, itemName = '') => {
      if (type === 'carbs' || type === 'snackCarbs') {
        if (itemName.includes('飯')) {
          if (oilGrams === 0) return ['電鍋炊煮', '原味蒸煮'];
          if (oilGrams > 0 && oilGrams <= 5) return ['微油拌飯', '滴油炊煮']; 
          return ['熱炒(炒飯)', '黃金煎飯糰'];
        }
        if (itemName.includes('麵') || itemName.includes('粉')) {
          if (oilGrams === 0) return ['水煮川燙', '原味清蒸'];
          if (oilGrams > 0 && oilGrams <= 5) return ['清油拌勻', '水煮滴油'];
          return ['熱炒', '蔥油拌'];
        }
        if (itemName.includes('糕')) {
          if (oilGrams === 0) return ['電鍋蒸煮'];
          return ['少油香煎', '乾煎'];
        }
        if (['地瓜(熟)', '馬鈴薯(熟)', '南瓜(熟)', '芋頭(熟)', '玉米(熟)'].includes(itemName)) {
          if (oilGrams === 0) return ['電鍋蒸煮', '水煮'];
          if (oilGrams > 0 && oilGrams <= 5) return ['烤箱烘烤', '微油香煎'];
          return ['油煎', '香酥拔絲'];
        }
        return ['原味蒸煮', '炊煮'];
      }
      if (oilGrams === 0) {
        if (type === 'veggies') return ['川燙', '清蒸', '生菜沙拉'];
        if (type === 'proteins') return ['水煮', '清蒸', '舒肥', '烤箱(無油)'];
        if (type === 'sides') return ['涼拌', '無油悶煮'];
        return ['原味', '清蒸'];
      }
      if (oilGrams > 0 && oilGrams <= 5) {
        if (type === 'veggies') return ['水油炒', '蒜香燙青菜', '微波淋油'];
        return ['少油香煎', '微油清炒', '烤箱微油'];
      }
      if (oilGrams > 5 && oilGrams <= 10) return ['清炒', '乾煎', '嫩煎'];
      return ['熱炒', '紅燒', '酥炸', '爆炒'];
    };

    const getRandom = (arr) => arr[Math.floor(Math.random() * arr.length)];

    // --- 系統狀態管理 ---
    const state = {
      targets: { calories: 1800, protein: 120, fat: 50, carbs: 217.5 },
      tdeeParams: { gender: 'male', age: 30, height: 170, weight: 65, pal: 1.2 },
      isTdeeMode: false,
      hbvRatio: 50,
      numDays: 7,
      mealsConfig: { breakfast: true, lunch: true, dinner: true },
      snacksConfig: { morning: false, afternoon: true, evening: false },
      generatedMenu: null
    };

    // --- 運算邏輯 ---
    const calculateTotalStats = (menu) => {
      const totalActual = { p: 0, f: 0, c: 0, fiber: 0, na: 0, phos: 0, k: 0, ca: 0, mag: 0, epa: 0, n3: 0, b12: 0, vitA: 0, folic: 0, vitD: 0, fe: 0, zn: 0, se: 0 };
      const addNut = (item, weight) => {
        if(!item) return; const w = Number(weight) || 0;
        totalActual.p += (item.p || 0) * w; totalActual.f += (item.f || 0) * w; totalActual.c += (item.c || 0) * w;
        totalActual.fiber += (item.fiber || 0) * w; totalActual.na += (item.na || 0) * w; totalActual.phos += (item.phos || 0) * w;
        totalActual.k += (item.k || 0) * w; totalActual.ca += (item.ca || 0) * w; totalActual.mag += (item.mag || 0) * w;
        totalActual.epa += (item.epa || 0) * w; totalActual.n3 += (item.n3 || 0) * w;
        totalActual.b12 += (item.b12 || 0) * w; totalActual.vitA += (item.vitA || 0) * w;
        totalActual.folic += (item.folic || 0) * w; totalActual.vitD += (item.vitD || 0) * w;
        totalActual.fe += (item.fe || 0) * w; totalActual.zn += (item.zn || 0) * w; totalActual.se += (item.se || 0) * w;
      };
      menu.forEach(meal => {
        if(meal.isMain) {
          if (meal.carb) addNut(meal.carb.item, meal.carb.weight); if (meal.protein) addNut(meal.protein.item, meal.protein.weight);
          if (meal.side) addNut(meal.side.item, meal.side.weight); if (meal.veggie) addNut(meal.veggie.item, meal.veggie.weight);
          const oilItem = FOOD_DB.oils.find(o => o.name === meal.oilName);
          if(oilItem) {
            let totalOil = (meal.carb ? (Number(meal.carb.oil)||0) : 0) + (meal.protein ? (Number(meal.protein.oil)||0) : 0) + (meal.side ? (Number(meal.side.oil)||0) : 0) + (meal.veggie ? (Number(meal.veggie.oil)||0) : 0);
            if(meal.extra) { meal.extra.forEach(ex => { if (ex.oil > 0) totalOil += Number(ex.oil); }); }
            addNut(oilItem, totalOil);
          }
          if(meal.extra) meal.extra.forEach(ex => addNut(ex, ex.weight));
        } else {
          if(meal.items) meal.items.forEach(ex => addNut(ex, ex.weight));
        }
      });
      return { ...totalActual, calories: Math.round((totalActual.p * 4) + (totalActual.c * 4) + (totalActual.f * 9)) };
    };

    const generateMenu = () => {
      const multiDayMenu = [];
      let prevDayMealItems = { '早餐': [], '午餐': [], '晚餐': [], '早點': [], '午點': [], '晚點': [] };

      for (let day = 0; day < state.numDays; day++) {
        const newMeals = []; let currentDayItems = []; let nextPrevDayMealItems = { '早餐': [], '午餐': [], '晚餐': [], '早點': [], '午點': [], '晚點': [] };

        const getUniqueItem = (pool, mealName) => {
          let available = pool.filter(item => {
            const inSameDay = currentDayItems.includes(item.name);
            const inPrevDaySameMeal = prevDayMealItems[mealName] && prevDayMealItems[mealName].includes(item.name);
            return !inSameDay && !inPrevDaySameMeal; 
          });
          if (available.length === 0) available = pool.filter(item => !currentDayItems.includes(item.name));
          if (available.length === 0) available = pool;
          const selected = available[Math.floor(Math.random() * available.length)];
          currentDayItems.push(selected.name);
          if (nextPrevDayMealItems[mealName]) nextPrevDayMealItems[mealName].push(selected.name);
          return selected;
        };

        const getSnackItem = (mealName) => {
          const types = ['dairy', 'fruits', 'snackCarbs'];
          const selectedType = types[Math.floor(Math.random() * types.length)];
          const pool = FOOD_DB[selectedType];
          const item = getUniqueItem(pool, mealName);
          if (selectedType === 'dairy') return { ...item, weight: 240, type: 'dairy' };
          if (selectedType === 'fruits') return { ...item, weight: 130, type: 'fruits' };
          return { ...item, weight: 60, type: 'snackCarbs' };
        };

        const getSnackItems = (mealName) => Array.from({ length: Math.floor(Math.random() * 2) + 1 }, () => getSnackItem(mealName));
        const dailySnack1 = getSnackItems('早點'); const dailySnack2 = getSnackItems('午點'); const dailySnack3 = getSnackItems('晚點');

        let dairyP = 0;
        [...dailySnack1, ...dailySnack2, ...dailySnack3].forEach(s => { if (s.type === 'dairy') dairyP += (s.p || 0) * s.weight; });

        const hbvTargetP = state.targets.protein * (state.hbvRatio / 100);
        const activeMealsCount = (state.mealsConfig.breakfast ? 1 : 0) + (state.mealsConfig.lunch ? 1 : 0) + (state.mealsConfig.dinner ? 1 : 0);
        const mealsDivisor = Math.max(1, activeMealsCount);
        const mainDishTotalTargetP = Math.max(0, hbvTargetP - dairyP);
        const mainDishPerMealP = mainDishTotalTargetP / mealsDivisor;

        let tempTotalActualP = 0, tempTotalActualF = 0, tempTotalActualC = 0;
        [...dailySnack1, ...dailySnack2, ...dailySnack3].forEach(s => {
          tempTotalActualP += (s.p || 0) * s.weight; tempTotalActualF += (s.f || 0) * s.weight; tempTotalActualC += (s.c || 0) * s.weight;
        });

        const remainingTargets = {
          p: Math.max(0, state.targets.protein - tempTotalActualP) / mealsDivisor,
          f: Math.max(0, state.targets.fat - tempTotalActualF) / mealsDivisor,
          c: Math.max(0, state.targets.carbs - tempTotalActualC) / mealsDivisor
        };

        const createMainMeal = (mealName, extraItems = []) => {
          const carbItem = getUniqueItem(FOOD_DB.carbs, mealName); const proteinItem = getUniqueItem(FOOD_DB.proteins, mealName);
          const sideItem = getUniqueItem(FOOD_DB.sides, mealName); const veggieItem = getUniqueItem(FOOD_DB.veggies, mealName);
          const oilItem = getRandom(FOOD_DB.oils);

          const veggieWeight = 100; let proteinWeight = Math.max(0, mainDishPerMealP / proteinItem.p);
          let C_rem = remainingTargets.c - (veggieItem.c * veggieWeight);
          let P_rem = remainingTargets.p - (veggieItem.p * veggieWeight) - (proteinItem.p * proteinWeight);
          
          let sideWeight = 0; let carbWeight = 0;
          const ratio = (carbItem.c > 0) ? (carbItem.p / carbItem.c) : 0;
          const denom = sideItem.p - (sideItem.c * ratio);

          if (denom > 0.001) { sideWeight = (P_rem - C_rem * ratio) / denom; if (sideWeight < 0) sideWeight = 0; } 
          else { sideWeight = Math.max(0, P_rem / (sideItem.p || 1)); }

          carbWeight = (C_rem - sideWeight * sideItem.c) / (carbItem.c || 1);
          if (carbWeight < 0) { carbWeight = 0; sideWeight = Math.max(0, P_rem / (sideItem.p || 1)); }

          const currentFat = (veggieItem.f * veggieWeight) + (carbItem.f * carbWeight) + (proteinItem.f * proteinWeight) + (sideItem.f * sideWeight);
          let oilWeight = Math.max(0, (remainingTargets.f - currentFat) / oilItem.f);
          const roundedTotalOil = Math.round(oilWeight);

          let remainingOil = roundedTotalOil; const dishOils = [0, 0, 0, 0];
          while(remainingOil > 0) { dishOils[Math.floor(Math.random() * 4)]++; remainingOil--; }

          return {
            isMain: true, name: mealName, oilName: oilItem.name,
            targets: { c: remainingTargets.c, p: remainingTargets.p, f: remainingTargets.f, mainP: mainDishPerMealP },
            carb: { item: carbItem, weight: Math.round(carbWeight), method: getRandom(getCookingMethod(dishOils[0], 'carbs', carbItem.name)), oil: dishOils[0] },
            protein: { item: proteinItem, weight: Math.round(proteinWeight), method: getRandom(getCookingMethod(dishOils[1], 'proteins', proteinItem.name)), oil: dishOils[1] },
            side: { item: sideItem, weight: Math.round(sideWeight), method: getRandom(getCookingMethod(dishOils[2], 'sides', sideItem.name)), oil: dishOils[2] },
            veggie: { item: veggieItem, weight: Math.round(veggieWeight), method: getRandom(getCookingMethod(dishOils[3], 'veggies', veggieItem.name)), oil: dishOils[3] },
            extra: extraItems 
          };
        };

        if (state.mealsConfig.breakfast) {
          if (state.snacksConfig.morning) { newMeals.push(createMainMeal('早餐')); newMeals.push({ isMain: false, name: '早點', items: dailySnack1 }); } 
          else { newMeals.push(createMainMeal('早餐', dailySnack1)); }
        } else { newMeals.push({ isMain: false, name: '早點 (獨立保留)', items: dailySnack1 }); }

        if (state.mealsConfig.lunch) {
          if (state.snacksConfig.afternoon) { newMeals.push(createMainMeal('午餐')); newMeals.push({ isMain: false, name: '午點', items: dailySnack2 }); } 
          else { newMeals.push(createMainMeal('午餐', dailySnack2)); }
        } else { newMeals.push({ isMain: false, name: '午點 (獨立保留)', items: dailySnack2 }); }

        if (state.mealsConfig.dinner) {
          if (state.snacksConfig.evening) { newMeals.push(createMainMeal('晚餐')); newMeals.push({ isMain: false, name: '晚點', items: dailySnack3 }); } 
          else { newMeals.push(createMainMeal('晚餐', dailySnack3)); }
        } else { newMeals.push({ isMain: false, name: '晚點 (獨立保留)', items: dailySnack3 }); }

        prevDayMealItems = nextPrevDayMealItems;
        multiDayMenu.push({ day: day + 1, meals: newMeals, stats: calculateTotalStats(newMeals) });
      }
      state.generatedMenu = multiDayMenu;
      renderApp();
    };

    // --- HTML UI 產生器 ---
    const buildOptions = (selectedName) => ALL_OPTIONS.map(group => `<optgroup label="${group.label}">${group.options.map(o => `<option value="${o.name}" ${o.name === selectedName ? 'selected' : ''}>${o.name}</option>`).join('')}</optgroup>`).join('');

    const buildCategorySelect = (cat, selectedName) => {
      const dbMap = { carb: 'carbs', protein: 'proteins', side: 'sides', veggie: 'veggies' };
      return FOOD_DB[dbMap[cat]].map(o => `<option value="${o.name}" ${o.name === selectedName ? 'selected' : ''}>${o.name}</option>`).join('');
    };

    const renderSidebar = () => {
      const { targets, tdeeParams, isTdeeMode, hbvRatio, numDays, mealsConfig, snacksConfig } = state;
      const cCal = targets.calories || 1;
      const pPct = Math.round((targets.protein * 4 / cCal) * 100) || 0;
      const cPct = Math.round((targets.carbs * 4 / cCal) * 100) || 0;
      const fPct = Math.max(0, 100 - pPct - cPct);

      return `
        <div class="sidebar">
          <h2 class="panel-title flex-gap">🧮 參數設定</h2>
          <div class="space-y-4">
            <div class="box box-indigo space-y-2">
              <div class="flex-between"><label>📅 生成天數</label><span class="tag tag-extra" style="background:#c7d2fe">${numDays} 天</span></div>
              <input type="range" min="1" max="30" value="${numDays}" data-action="daysSlider">
            </div>

            <div class="flex-gap">
              <button class="btn ${!isTdeeMode ? 'btn-primary' : 'btn-outline'}" data-action="toggleMode" data-mode="manual">手動輸入</button>
              <button class="btn ${isTdeeMode ? 'btn-primary' : 'btn-outline'}" data-action="toggleMode" data-mode="tdee">TDEE 試算</button>
            </div>

            ${isTdeeMode ? `
              <div class="box box-indigo space-y-3">
                <div class="flex-gap">
                  <button class="btn ${tdeeParams.gender === 'male' ? 'btn-primary' : 'btn-outline'}" data-action="toggleGender" data-gender="male">男性</button>
                  <button class="btn ${tdeeParams.gender === 'female' ? 'btn-primary' : 'btn-outline'}" data-action="toggleGender" data-gender="female">女性</button>
                </div>
                <div class="grid-2">
                  <div><label>年齡 (歲)</label><input type="number" value="${tdeeParams.age}" data-action="tdeeInput" data-field="age" data-type="num"></div>
                  <div><label>身高 (cm)</label><input type="number" value="${tdeeParams.height}" data-action="tdeeInput" data-field="height" data-type="num"></div>
                </div>
                <div><label>體重 (kg)</label><input type="number" value="${tdeeParams.weight}" data-action="tdeeInput" data-field="weight" data-type="num"></div>
                <div>
                  <label>活動量 (PAL)</label>
                  <select data-action="tdeeInput" data-field="pal" data-type="num">
                    <option value="1.2" ${tdeeParams.pal==1.2?'selected':''}>1.2 - 幾乎不動</option>
                    <option value="1.375" ${tdeeParams.pal==1.375?'selected':''}>1.375 - 輕度活動</option>
                    <option value="1.55" ${tdeeParams.pal==1.55?'selected':''}>1.55 - 中度活動</option>
                    <option value="1.725" ${tdeeParams.pal==1.725?'selected':''}>1.725 - 高度活動</option>
                  </select>
                </div>
                <button class="btn btn-primary" data-action="calcTdee">計算並分配營養素</button>
              </div>
            ` : ''}

            <div class="space-y-3 pt-2" style="border-top: 1px solid var(--border);">
              <div><label>單日總熱量目標 (kcal)</label><input type="number" value="${targets.calories}" data-action="macroInput" data-field="calories" style="font-weight:bold; color:var(--primary); background:var(--primary-light);"></div>
              <div class="box box-rose space-y-2">
                <div class="flex-between"><label style="color:var(--rose)">1. 蛋白質</label><span class="tag" style="background:#fecdd3; color:var(--rose)">${pPct}%</span></div>
                <input type="range" value="${pPct}" data-action="macroSlider" data-field="p" style="accent-color:var(--rose)">
                <div class="flex-center"><input type="number" value="${targets.protein}" data-action="macroInput" data-field="protein"><span style="color:var(--rose)">g</span></div>
              </div>
              <div class="box box-amber space-y-2">
                <div class="flex-between"><label style="color:var(--warning)">2. 碳水</label><span class="tag" style="background:#fde68a; color:var(--warning)">${cPct}%</span></div>
                <input type="range" value="${cPct}" data-action="macroSlider" data-field="c" style="accent-color:var(--warning)">
                <div class="flex-center"><input type="number" value="${targets.carbs}" data-action="macroInput" data-field="carbs"><span style="color:var(--warning)">g</span></div>
              </div>
              <div class="box box-emerald space-y-2">
                <div class="flex-between"><label style="color:var(--success)">3. 脂肪</label><span class="tag" style="background:#a7f3d0; color:var(--success)">${fPct}%</span></div>
                <input type="range" value="${fPct}" data-action="macroSlider" data-field="f" style="accent-color:var(--success)">
                <div class="flex-center"><input type="number" value="${targets.fat}" data-action="macroInput" data-field="fat"><span style="color:var(--success)">g</span></div>
              </div>
            </div>

            <div class="box box-sky space-y-2 pt-2" style="background:#f0f9ff; border-color:#bae6fd;">
              <div class="flex-between"><label style="color:var(--sky)">主菜及乳品佔比 (HBV)</label><span class="tag" style="background:#bae6fd; color:var(--sky)">${hbvRatio}%</span></div>
              <input type="range" value="${hbvRatio}" data-action="hbvSlider" style="accent-color:var(--sky)">
            </div>

            <div class="space-y-4 pt-2" style="border-top: 1px solid var(--border);">
              <div class="space-y-2">
                <label>正餐開關</label>
                <div class="flex-gap">${['breakfast','lunch','dinner'].map((m,i)=>`<button class="btn ${mealsConfig[m]?'btn-primary':'btn-outline'}" style="padding:8px; font-size:0.85rem;" data-action="toggleMeal" data-meal="${m}">${mealsConfig[m]?'✅':'⬜'} ${['早餐','午餐','晚餐'][i]}</button>`).join('')}</div>
              </div>
              <div class="space-y-2">
                <label>點心設定</label>
                <div class="grid-2">${['morning','afternoon','evening'].map((s,i)=>`<button class="btn ${snacksConfig[s]?'btn-primary':'btn-outline'}" style="padding:8px; font-size:0.85rem;" data-action="toggleSnack" data-snack="${s}">${snacksConfig[s]?'✅':'⬜'} ${['早點','午點','晚點'][i]}</button>`).join('')}</div>
              </div>
            </div>

            <div class="space-y-2 pt-3">
              <button class="btn btn-primary" data-action="generate" style="background:#10b981;">🍽️ 一鍵生成菜單</button>
              
              <!-- 📥 匯入與匯出按鈕區塊 -->
              <div class="grid-2 mt-2">
                <button class="btn btn-outline" data-action="exportHTML" style="color:var(--success); border-color:var(--success); font-size:0.85rem; padding:8px;">📄 匯出 (HTML)</button>
                <button class="btn btn-outline" data-action="triggerCSV" style="color:var(--sky); border-color:var(--sky); font-size:0.85rem; padding:8px;">📥 匯入食譜</button>
                <input type="file" id="csvFileInput" accept=".csv" style="display:none;" data-action="handleCSV">
              </div>
              <button class="btn btn-outline mt-2" data-action="downloadTemplate" style="color:var(--text-muted); border-color:var(--border); font-size:0.8rem; padding:6px; background:var(--bg-color);">⬇️ 下載食譜 CSV 範本</button>
              <button class="btn btn-outline mt-2" data-action="print" style="color:var(--primary); border-color:var(--primary); font-size:0.85rem; padding:8px;">🖨️ 列印 / 存為 PDF</button>
            </div>
          </div>
        </div>
      `;
    };

    const renderMain = () => {
      if (!state.generatedMenu) return `<div class="main-content"></div>`;
      
      const daysHtml = state.generatedMenu.map((dayData, dIdx) => `
        <div class="day-container">
          <div class="day-header">第 ${dayData.day} 天 <span class="day-target">目標：${state.targets.calories} kcal</span></div>
          
          <div class="stats-panel">
            <div class="stats-row">
              <div class="stat-item"><span class="stat-label">熱量</span><span class="stat-val ${Math.abs(dayData.stats.calories-state.targets.calories)>50?'warn':'ok'}">${dayData.stats.calories}<span style="font-size:0.8rem">kcal</span></span></div>
              <div class="stat-item"><span class="stat-label">蛋白質</span><span class="stat-val">${Math.round(dayData.stats.p)}g</span></div>
              <div class="stat-item"><span class="stat-label">脂肪</span><span class="stat-val">${Math.round(dayData.stats.f)}g</span></div>
              <div class="stat-item"><span class="stat-label">碳水</span><span class="stat-val">${Math.round(dayData.stats.c)}g</span></div>
            </div>
            <div class="micro-grid">
              <div class="micro-box"><div class="micro-label">纖維 Fiber</div><div class="micro-val">${Math.round(dayData.stats.fiber)}<span>g</span></div></div>
              <div class="micro-box"><div class="micro-label">鈉 Na</div><div class="micro-val">${Math.round(dayData.stats.na)}<span>mg</span></div></div>
              <div class="micro-box"><div class="micro-label">磷 Phos</div><div class="micro-val">${Math.round(dayData.stats.phos)}<span>mg</span></div></div>
              <div class="micro-box"><div class="micro-label">鉀 K</div><div class="micro-val">${Math.round(dayData.stats.k)}<span>mg</span></div></div>
              <div class="micro-box"><div class="micro-label">鈣 Ca</div><div class="micro-val">${Math.round(dayData.stats.ca)}<span>mg</span></div></div>
